# Copy to .env.local (or set in your hosting provider) and fill in the values.

# Data Vallis API - only used for news / categories now
NEXT_PUBLIC_API_ENDPOINT=https://api.datavallis.si/v1
NEXT_PUBLIC_API_KEY=your-api-key-here
NEXT_PUBLIC_CDN=https://cdn.datavallis.si/

# Klaviyo - contact form submissions (server only, never exposed to the browser)
# Private API key with scopes: Profiles (write), Lists (write), Events (write)
KLAVIYO_PRIVATE_API_KEY=pk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Lists & Segments -> your list -> Settings -> "List ID" (6 characters, e.g. AbC123)
KLAVIYO_LIST_ID=XXXXXX
# Optional - Klaviyo API revision
# KLAVIYO_API_REVISION=2025-10-15
